{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "copilot-usage",
      "runtimeExecutable": "uv",
      "runtimeArgs": [
        "run",
        "app.py",
        "--port",
        "5058"
      ],
      "port": 5058
    },
    {
      "name": "site",
      "runtimeExecutable": "pnpm",
